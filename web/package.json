{
  "name": "zh-fraud-demo",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "中文电诈识别项目展示页（静态单页 + 在线检测台）",
  "scripts": {
    "dev": "vite",
    "build": "npm run validate && tsc --noEmit && vite build",
    "preview": "vite preview",
    "mock": "node scripts/gen_mock.ts",
    "mock:default": "node scripts/gen_mock.ts",
    "mock:only-fasttext": "node scripts/gen_mock.ts",
    "mock:multi-model": "node scripts/gen_mock.ts",
    "mock:no-confusion": "node scripts/gen_mock.ts",
    "mock:no-calibration-bins": "node scripts/gen_mock.ts",
    "mock:no-score-dist": "node scripts/gen_mock.ts",
    "mock:saturated-demo": "node scripts/gen_mock.ts",
    "mock:all": "node scripts/gen_mock.ts",
    "validate": "node scripts/validate_data.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.1",
    "echarts": "^5.5.1",
    "gsap": "^3.12.5"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
